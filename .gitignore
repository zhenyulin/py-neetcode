# NOTE: the syntax except case sensitive is platform agnostic
# case insensitive: MacOs, Windows
# case sensitive: Linux
#
# syntax:
# project root: /<expression>, without the anchor expression would be resolved recursively
# directory: <expression>/
#   - use <expression>/* with !<expression>/.gitkeep
#   - <expression>/ would ignore any subfolder rule
# single asterisk * : wildcard except directory separator /
# double asterisk ** : wildcard including directory separator /
# not operator !

# virtualenv
/.venv/

# cache
__pycache__/
/*cache*
/*log*

# sensitive
/*credential*
/*.env*
!/.env-template
!/.env-kv
/.config*
!/.config-template
**.crt

# test
/.benchmarks/
/.coverage*
!.coveragerc
/report/

# output
/output/*
!/output/.gitkeep

# mac specific
.DS_Store

# local utils
TODO.md

# * <- repo specific config start:
# build
/build/
/cython/build/
/cython/**.egg-info/
/cython/**/*.c
/cython/**/*.so
/rust/target/
# * repo specific config end ->
